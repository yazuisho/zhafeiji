.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e, #16213e);
}
.header {
  text-align: center;
  margin-bottom: 40rpx;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #e94560;
  letter-spacing: 8rpx;
}
.copy-btn {
  margin-top: 16rpx;
  background: #0f3460;
  color: #88bbdd;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
  border: 2rpx solid #1a4a7a;
}
.section-title {
  font-size: 28rpx;
  color: #8899aa;
  margin-bottom: 20rpx;
  display: block;
}
.players-area {
  width: 100%;
}
.player-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #0f3460;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #1a4a7a;
}
.player-info {
  display: flex;
  flex-direction: column;
}
.player-name {
  font-size: 32rpx;
  color: #e0e0e0;
  font-weight: 600;
}
.player-status {
  font-size: 24rpx;
  color: #667788;
  margin-top: 4rpx;
}
.player-status.ready {
  color: #4ecca3;
}
.player-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #1a2a4a;
  color: #667788;
}
.player-badge.host {
  background: rgba(233,69,96,0.2);
  color: #e94560;
}
.waiting-card {
  background: #0a1a3a;
  border: 2rpx dashed #1a4a7a;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
}
.waiting-text {
  font-size: 30rpx;
  color: #667788;
}
.waiting-hint {
  font-size: 24rpx;
  color: #445566;
  margin-top: 12rpx;
  display: block;
}
.action-area {
  width: 100%;
  margin-top: auto;
  padding-top: 40rpx;
}
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}
.ready-btn {
  background: #0f3460;
  color: #e0e0e0;
  border: 2rpx solid #1a4a7a;
}
.ready-btn.active {
  background: #4ecca3;
  color: #1a1a2e;
  border-color: #4ecca3;
}
.start-btn {
  background: linear-gradient(135deg, #e94560, #c23152);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(233,69,96,0.3);
}
.leave-btn {
  background: transparent;
  color: #667788;
  border: 2rpx solid #334466;
}
