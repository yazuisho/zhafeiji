page {
  background-color: #16213e;
  color: #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
button {
  background-color: #0f3460;
  color: #e0e0e0;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 16px;
}
