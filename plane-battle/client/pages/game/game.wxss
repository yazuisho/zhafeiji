.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e, #16213e);
}
.phase-banner {
  width: 100%;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.phase-banner.placement { background: #0f3460; color: #88bbdd; }
.phase-banner.battle { background: #1a3a5c; color: #e0e0e0; }
.phase-banner.gameover { background: #e94560; color: white; }

.view-toggle {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.toggle-btn {
  padding: 8rpx 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #0f3460;
  color: #667788;
  border: 2rpx solid #1a4a7a;
}
.toggle-btn.active {
  background: #e94560;
  color: white;
  border-color: #e94560;
}

.status-line {
  margin-bottom: 8rpx;
  font-size: 26rpx;
}
.result-hit { color: #4ecca3; font-weight: 600; }
.result-miss { color: #8899aa; }
.destroyed-text { color: #88bbdd; }

.grid-wrapper {
  display: flex;
  justify-content: center;
  width: 100%;
  max-width: 750rpx;
}
.grid {
  display: inline-flex;
  flex-direction: column;
  gap: 4rpx;
}
.grid-row {
  display: flex;
  gap: 4rpx;
  align-items: center;
}
.row-label, .col-label {
  width: 40rpx;
  text-align: center;
  font-size: 20rpx;
  color: #556677;
}
.cell {
  width: 64rpx;
  height: 64rpx;
  border-radius: 6rpx;
  background: #0a1a3a;
  border: 2rpx solid #1a2a4a;
  transition: all 0.15s;
}
.cell-0 { background: #0a1a3a; border-color: #1a2a4a; }
.cell-1 { background: #3a7bd5; border-color: #4a8be5; }
.cell-2 { background: #e94560; border-color: #f95570; }
.cell-3 { background: #2a3a5a; border-color: #3a4a6a; }
.cell-4 { background: #0a1a3a; border-color: #1a2a4a; }

.cell.preview { border-color: #4ecca3; border-width: 3rpx; }
.cell.preview-ok { background: rgba(78,204,163,0.15); }

.bottom-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}
.control-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}
.ctrl-btn {
  background: #0f3460;
  color: #e0e0e0;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 12rpx;
  border: 2rpx solid #1a4a7a;
}
.plane-tip {
  font-size: 24rpx;
  color: #667788;
  margin-bottom: 12rpx;
}
.btn {
  width: 80%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}
.ready-btn {
  background: #0f3460;
  color: #667788;
  border: 2rpx solid #1a4a7a;
}
.ready-btn.active {
  background: #4ecca3;
  color: #1a1a2e;
  border-color: #4ecca3;
}
.home-btn {
  background: #0f3460;
  color: #e0e0e0;
  border: 2rpx solid #1a4a7a;
}
