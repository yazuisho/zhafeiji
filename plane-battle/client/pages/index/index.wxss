.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
}
.title-area {
  margin-top: 80rpx;
  margin-bottom: 60rpx;
  text-align: center;
}
.title {
  font-size: 80rpx;
  font-weight: 700;
  color: #e94560;
  text-shadow: 0 0 30rpx rgba(233,69,96,0.3);
  letter-spacing: 12rpx;
}
.subtitle {
  font-size: 28rpx;
  color: #8899aa;
  margin-top: 16rpx;
  display: block;
}
.name-area {
  width: 100%;
  margin-bottom: 40rpx;
}
.label {
  font-size: 28rpx;
  color: #aabbcc;
  margin-bottom: 12rpx;
  display: block;
}
.input {
  width: 100%;
  height: 80rpx;
  background: #0f3460;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #e0e0e0;
  box-sizing: border-box;
  border: 2rpx solid #1a4a7a;
}
.btn-area {
  width: 100%;
  margin-top: 40rpx;
}
.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 20rpx;
}
.btn.primary {
  background: linear-gradient(135deg, #e94560, #c23152);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(233,69,96,0.3);
}
.btn.secondary {
  background: #0f3460;
  color: #e0e0e0;
  border: 2rpx solid #1a4a7a;
  width: 200rpx;
  flex-shrink: 0;
}
.divider {
  text-align: center;
  margin: 20rpx 0;
  position: relative;
}
.divider-text {
  background: #16213e;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #667788;
}
.join-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.code-input {
  flex: 1;
}
.footer {
  position: fixed;
  bottom: 60rpx;
}
.hint {
  font-size: 24rpx;
  color: #556677;
}
